# Copy to .env and adjust as needed. All values are optional (sane defaults shown).
# scripts/setup.sh and scripts/start.sh auto-source this file.

# --- Ports ---
PAPERCLIP_PORT=3100        # Paperclip API + dashboard
CLAW3D_PORT=3000           # Claw3D 3D office
GATEWAY_PORT=18789         # Paperclip <-> Claw3D bridge (WebSocket)

# --- Company / team ---
# Which company the bridge + provision target. UUID, issue-prefix, or name.
# Leave empty to use (or create) the first company.
COMPANY=

# Agent loop cadence hint (Paperclip heartbeat interval, ms).
HEARTBEAT_MS=30000

# --- Autoscaler (dynamic worker pool) ---
AUTOSCALE=0                # 1 = grow/shrink a worker pool with the backlog
AUTOSCALE_MIN=0            # minimum extra workers
AUTOSCALE_MAX=5            # maximum extra workers
AUTOSCALE_PER_AGENT=3      # open issues per worker before scaling up
AUTOSCALE_INTERVAL_MS=20000

# --- Upstream pins (override to track newer Paperclip / Claw3D) ---
# PAPERCLIP_REF=f12bb27bcd1b36148090d6922a85bf1611d327e0
# CLAW3D_REF=70ba84c1b13322eb660a6f7f5c53e36e7067c412
# PNPM_VERSION=9.15.4

# --- Windows only ---
# Explicit Git Bash path if auto-detection fails (see docs).
# PAPERCLIP_GIT_BASH=C:\Program Files\Git\bin\bash.exe
